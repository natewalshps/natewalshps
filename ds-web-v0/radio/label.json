{
  "components": {
    "radio": {
      "primary": {
        "label": {
          "desktop": {
            "active": {
              "font": {
                "color": {
                  "$value": "{base.palette.neutral.90}",
                  "$type": "color"
                }
              }
            },
            "disabled": {
              "font": {
                "color": {
                  "$value": "{base.palette.neutral.70}",
                  "$type": "color"
                }
              }
            },
            "focus": {
              "font": {
                "color": {
                  "$value": "{base.palette.neutral.70}",
                  "$type": "color"
                }
              }
            },
            "font": {
              "color": {
                "$value": "{base.palette.neutral.70}",
                "$type": "color"
              },
              "line-height": {
                "$value": "{base.typography.desktop.body1.$value.lineHeight}",
                "$type": "dimension"
              },
              "size": {
                "$value": "{base.typography.desktop.body1.$value.fontSize}",
                "$type": "dimension"
              },
              "weight": {
                "$value": "{base.typography.desktop.body1.$value.fontWeight}",
                "$type": "fontWeight"
              }
            },
            "hover": {
              "font": {
                "color": {
                  "$value": "{base.palette.neutral.90}",
                  "$type": "color"
                }
              }
            }
          },
          "mobile": {
            "font": {
              "line-height": {
                "$value": "{base.typography.mobile.body1.$value.lineHeight}",
                "$type": "dimension"
              },
              "size": {
                "$value": "{base.typography.mobile.body1.$value.fontSize}",
                "$type": "dimension"
              },
              "weight": {
                "$value": "{base.typography.mobile.body1.$value.fontWeight}",
                "$type": "fontWeight"
              }
            }
          },
          "selected": {
            "desktop": {
              "font": {
                "color": {
                  "$value": "{base.palette.neutral.70}",
                  "$type": "color"
                }
              },
              "hover": {
                "font": {
                  "color": {
                    "$value": "{base.palette.neutral.90}",
                    "$type": "color"
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
