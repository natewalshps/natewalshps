{
  "components": {
    "radio": {
      "primary": {
        "chip": {
          "desktop": {
            "background": {
              "color": {
                "$value": "{base.palette.background.default}",
                "$type": "color"
              }
            },
            "border": {
              "color": {
                "$value": "{base.palette.secondary.linkblue}",
                "$type": "color"
              },
              "radius": {
                "$value": "4px",
                "$type": "dimension"
              },
              "style": {
                "$value": "{base.border.style.solid}",
                "$type": "string"
              },
              "width": {
                "$value": "{base.border.width.xxs}",
                "$type": "dimension"
              }
            },
            "disabled": {
              "background": {
                "color": {
                  "$value": "{base.palette.background.default}",
                  "$type": "color"
                }
              },
              "border": {
                "color": {
                  "$value": "{base.palette.neutral.30}",
                  "$type": "color"
                }
              },
              "font": {
                "color": {
                  "$value": "{base.palette.neutral.30}",
                  "$type": "color"
                }
              }
            },
            "font": {
              "color": {
                "$value": "{base.palette.secondary.linkblue}",
                "$type": "color"
              },
              "line-height": {
                "$value": "16px",
                "$type": "dimension"
              },
              "size": {
                "$value": "12.64px",
                "$type": "dimension"
              },
              "weight": {
                "$value": "700",
                "$type": "fontWeight"
              }
            },
            "hover": {
              "border": {
                "color": {
                  "$value": "{base.palette.secondary.darkblue}",
                  "$type": "color"
                }
              },
              "font": {
                "color": {
                  "$value": "{base.palette.secondary.darkblue}",
                  "$type": "color"
                }
              }
            },
            "large": {
              "font": {
                "line-height": {
                  "$value": "{base.typography.desktop.body2-bold.$value.lineHeight}",
                  "$type": "dimension"
                },
                "size": {
                  "$value": "{base.typography.desktop.body2-bold.$value.fontSize}",
                  "$type": "dimension"
                },
                "weight": {
                  "$value": "{base.typography.desktop.body2-bold.$value.fontWeight}",
                  "$type": "fontWeight"
                }
              },
              "padding": {
                "all": {
                  "$value": "7px 8px",
                  "$type": "string"
                }
              }
            },
            "padding": {
              "all": {
                "$value": "4px 8px",
                "$type": "string"
              }
            },
            "selected": {
              "background": {
                "color": {
                  "$value": "{base.palette.secondary.darkblue}",
                  "$type": "color"
                }
              },
              "border": {
                "color": {
                  "$value": "{base.palette.secondary.darkblue}",
                  "$type": "color"
                }
              },
              "font": {
                "color": {
                  "$value": "{base.palette.background.default}",
                  "$type": "color"
                }
              },
              "hover": {
                "background": {
                  "color": {
                    "$value": "{base.palette.secondary.linkblue}",
                    "$type": "color"
                  }
                },
                "border": {
                  "color": {
                    "$value": "{base.palette.secondary.linkblue}",
                    "$type": "color"
                  }
                },
                "font": {
                  "color": {
                    "$value": "{base.palette.background.default}",
                    "$type": "color"
                  }
                }
              }
            }
          },
          "mobile": {
            "font": {
              "line-height": {
                "$value": "16px",
                "$type": "dimension"
              },
              "size": {
                "$value": "12.64px",
                "$type": "dimension"
              },
              "weight": {
                "$value": "700",
                "$type": "fontWeight"
              }
            },
            "large": {
              "font": {
                "line-height": {
                  "$value": "{base.typography.mobile.body2-bold.$value.lineHeight}",
                  "$type": "dimension"
                },
                "size": {
                  "$value": "{base.typography.mobile.body2-bold.$value.fontSize}",
                  "$type": "dimension"
                },
                "weight": {
                  "$value": "{base.typography.mobile.body2-bold.$value.fontWeight}",
                  "$type": "fontWeight"
                }
              }
            }
          }
        }
      }
    }
  }
}
