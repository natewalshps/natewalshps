{
  "components": {
    "filterchip": {
      "descriptive-text": {
        "desktop": {
          "font": {
            "color": {
              "$value": "{base.palette.neutral.80}",
              "$type": "color"
            },
            "line-height": {
              "$value": "{base.typography.desktop.body2.$value.lineHeight}",
              "$type": "dimension"
            },
            "size": {
              "$value": "{base.typography.desktop.body2.$value.fontSize}",
              "$type": "dimension"
            },
            "weight": {
              "$value": "{base.typography.desktop.body2.$value.fontWeight}",
              "$type": "fontWeight"
            }
          }
        },
        "mobile": {
          "font": {
            "size": {
              "$value": "{base.typography.mobile.body2.$value.fontSize}",
              "$type": "dimension"
            },
            "weight": {
              "$value": "{base.typography.mobile.body2.$value.fontWeight}",
              "$type": "fontWeight"
            }
          }
        }
      },
      "selectable": {
        "mobile": {
          "font": {
            "line-height": {
              "$value": "{base.typography.mobile.body2.$value.lineHeight}",
              "$type": "dimension"
            }
          }
        }
      }
    }
  }
}
