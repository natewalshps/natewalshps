{
  "components": {
    "orderSummaryCard": {
      "orderTotal": {
        "container": {
          "desktop": {
            "background": {
              "color": {
                "$value": "{base.palette.background.default}",
                "$type": "color"
              }
            },
            "border": {
              "color": {
                "$value": "{base.palette.background.default}",
                "$type": "color"
              },
              "radius": {
                "all": {
                  "$value": "{base.border.desktop.radius.sm}",
                  "$type": "dimension"
                }
              },
              "style": {
                "$value": "{base.border.style.solid}",
                "$type": "string"
              },
              "width": {
                "$value": "{base.border.width.xxs}",
                "$type": "dimension"
              }
            },
            "padding": {
              "all": {
                "$value": "0px 8px",
                "$type": "string"
              }
            }
          }
        }
      }
    }
  }
}
