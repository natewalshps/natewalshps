{
  "components": {
    "orderSummaryCard": {
      "container": {
        "desktop": {
          "background": {
            "color": {
              "$value": "{base.palette.secondary.skyblue}",
              "$type": "color"
            }
          },
          "border": {
            "color": {
              "$value": "{base.palette.secondary.skyblue}",
              "$type": "color"
            },
            "radius": {
              "all": {
                "$value": "{base.border.desktop.radius.lg}",
                "$type": "dimension"
              }
            },
            "style": {
              "$value": "{base.border.style.solid}",
              "$type": "string"
            },
            "width": {
              "$value": "{base.border.width.xxs}",
              "$type": "dimension"
            }
          },
          "padding": {
            "all": {
              "$value": "32px",
              "$type": "dimension"
            }
          }
        }
      }
    }
  }
}
