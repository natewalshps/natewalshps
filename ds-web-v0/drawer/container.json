{
  "components": {
    "drawer": {
      "container": {
        "desktop": {
          "background": {
            "color": {
              "$value": "{base.palette.background.default}",
              "$type": "color"
            }
          },
          "border": {
            "radius": {
              "all": {
                "$value": "12px 0px 0px 12px",
                "$type": "string"
              }
            }
          },
          "box-shadow": {
            "$value": "0px 4px 12px rgba(25,25,26,0.16)",
            "$type": "string"
          },
          "maxWidth": {
            "$value": "596px",
            "$type": "dimension"
          },
          "padding": {
            "all": {
              "$value": "24px",
              "$type": "dimension"
            }
          },
          "width": {
            "$value": "596px",
            "$type": "dimension"
          }
        },
        "mobile": {
          "border": {
            "radius": {
              "all": {
                "$value": "0px",
                "$type": "dimension"
              }
            }
          },
          "max-height": {
            "$value": "90%",
            "$type": "dimension"
          },
          "maxWidth": {
            "$value": "{base.dimensions.percent.100}"
          },
          "padding": {
            "all": {
              "$value": "16px",
              "$type": "dimension"
            }
          },
          "width": {
            "$value": "{base.dimensions.percent.100}",
            "$type": "dimension"
          }
        }
      }
    }
  }
}
