{
  "components": {
    "switchInput": {
      "label": {
        "desktop": {
          "font": {
            "color": {
              "$value": "{base.palette.neutral.70}",
              "$type": "color"
            },
            "line-height": {
              "$value": "{base.typography.desktop.subtitle1-bold.$value.lineHeight}",
              "$type": "dimension"
            },
            "size": {
              "$value": "{base.typography.desktop.subtitle1-bold.$value.fontSize}",
              "$type": "dimension"
            },
            "weight": {
              "$value": "{base.typography.desktop.subtitle1-bold.$value.fontWeight}",
              "$type": "fontWeight"
            }
          }
        },
        "mobile": {
          "font": {
            "line-height": {
              "$value": "{base.typography.mobile.subtitle1-bold.$value.lineHeight}",
              "$type": "dimension"
            },
            "size": {
              "$value": "{base.typography.mobile.subtitle1-bold.$value.fontSize}",
              "$type": "dimension"
            },
            "weight": {
              "$value": "{base.typography.mobile.subtitle1-bold.$value.fontWeight}",
              "$type": "fontWeight"
            }
          }
        }
      }
    }
  }
}
