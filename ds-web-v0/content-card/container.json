{
  "components": {
    "content-card": {
      "desktop": {
        "background": {
          "color": {
            "$value": "{base.palette.background.default}",
            "$type": "color"
          }
        },
        "border": {
          "color": {
            "$value": "{base.palette.neutral.42}",
            "$type": "color"
          },
          "radius": {
            "all": {
              "$value": "12px",
              "$type": "dimension"
            }
          },
          "style": {
            "$value": "{base.border.style.solid}",
            "$type": "string"
          },
          "width": {
            "$value": "{base.border.width.xxs}",
            "$type": "dimension"
          }
        },
        "highlighted": {
          "background": {
            "color": {
              "$value": "{base.palette.secondary.skyblue}",
              "$type": "color"
            }
          }
        },
        "padding": {
          "all": {
            "$value": "20px 16px",
            "$type": "string"
          }
        }
      }
    }
  }
}
