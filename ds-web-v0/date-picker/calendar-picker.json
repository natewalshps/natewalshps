{
  "components": {
    "datepicker": {
      "calpicker": {
        "desktop": {
          "background": {
            "color": {
              "$value": "{base.palette.background.default}",
              "$type": "color"
            }
          },
          "border": {
            "radius": {
              "all": {
                "$value": "4px",
                "$type": "dimension"
              }
            }
          },
          "filter": {
            "$value": "drop-shadow(0px 4px 4px rgba(0, 0, 0, 0.25))",
            "$type": "string"
          }
        }
      }
    }
  }
}
