{
  "components": {
    "datepicker": {
      "date": {
        "desktop": {
          "focus": {
            "border": {
              "color": {
                "$value": "{base.palette.secondary.linkblue}",
                "$type": "color"
              },
              "radius": {
                "all": {
                  "$value": "3px",
                  "$type": "dimension"
                }
              },
              "style": {
                "$value": "{base.border.style.solid}",
                "$type": "string"
              },
              "width": {
                "$value": "{base.border.width.xs}",
                "$type": "dimension"
              }
            }
          },
          "font": {
            "color": {
              "$value": "{base.palette.neutral.70}",
              "$type": "color"
            },
            "line-height": {
              "$value": "{base.typography.desktop.body1.$value.lineHeight}",
              "$type": "dimension"
            },
            "size": {
              "$value": "{base.typography.desktop.body1.$value.fontSize}",
              "$type": "dimension"
            },
            "weight": {
              "$value": "{base.typography.desktop.body1.$value.fontWeight}",
              "$type": "fontWeight"
            }
          },
          "hover": {
            "background": {
              "color": {
                "$value": "{base.palette.secondary.skyblue}",
                "$type": "color"
              }
            },
            "border": {
              "radius": {
                "all": {
                  "$value": "3px",
                  "$type": "dimension"
                }
              }
            },
            "font": {
              "weight": {
                "$value": "{base.typography.desktop.body1-bold.$value.fontWeight}",
                "$type": "fontWeight"
              }
            }
          },
          "inactive": {
            "font": {
              "color": {
                "$value": "{base.palette.neutral.30}",
                "$type": "color"
              }
            }
          }
        },
        "mobile": {
          "font": {
            "line-height": {
              "$value": "{base.typography.mobile.body1.$value.lineHeight}",
              "$type": "dimension"
            },
            "size": {
              "$value": "{base.typography.mobile.body1.$value.fontSize}",
              "$type": "dimension"
            },
            "weight": {
              "$value": "{base.typography.mobile.body1.$value.fontWeight}",
              "$type": "fontWeight"
            }
          }
        }
      }
    }
  }
}
