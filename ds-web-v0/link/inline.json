{
  "components": {
    "link": {
      "inline": {
        "desktop": {
          "active": {
            "font": {
              "color": {
                "$value": "{base.palette.secondary.darkblue}",
                "$type": "color"
              }
            }
          },
          "focus": {
            "outline": {
              "color": {
                "$value": "{base.focus.outline.color}",
                "$type": "color"
              },
              "style": {
                "$value": "{base.focus.outline.style}",
                "$type": "string"
              },
              "width": {
                "$value": "{base.focus.outline.width}",
                "$type": "dimension"
              }
            }
          },
          "font": {
            "color": {
              "$value": "{base.palette.secondary.linkblue}",
              "$type": "color"
            },
            "family": {
              "$value": "{base.font.family}",
              "$type": "fontFamily"
            },
            "line-height": {
              "$value": "{base.font.line-height.20}",
              "$type": "dimension"
            },
            "size": {
              "$value": "16px",
              "$type": "dimension"
            },
            "text-decoration": {
              "$value": "underline"
            },
            "weight": {
              "$value": "400",
              "$type": "fontWeight"
            }
          },
          "hover": {
            "font": {
              "color": {
                "$value": "{base.palette.secondary.darkblue}",
                "$type": "color"
              },
              "text-decoration": {
                "$value": "none"
              }
            }
          }
        },
        "mobile": {
          "font": {
            "family": {
              "$value": "{base.font.family}",
              "$type": "fontFamily"
            },
            "line-height": {
              "$value": "{base.font.line-height.20}",
              "$type": "dimension"
            },
            "size": {
              "$value": "16px",
              "$type": "dimension"
            },
            "weight": {
              "$value": "400",
              "$type": "fontWeight"
            }
          }
        }
      }
    }
  }
}
