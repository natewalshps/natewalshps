                }
              }
            }
          }
        },
        "mobile": {
          "font": {
            "line-height": {
              "$value": "{base.typography.mobile.subtitle1-bold.$value.lineHeight}",
              "$type": "dimension"
            },
            "size": {
              "$value": "{base.typography.mobile.subtitle1-bold.$value.fontSize}",
              "$type": "dimension"
            },
            "weight": {
              "$value": "{base.typography.mobile.subtitle1-bold.$value.fontWeight}",
