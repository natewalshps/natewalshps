{
  "components": {
    "orderTrackerBar": {
      "container": {
        "desktop": {
          "background": {
            "color": {
              "$value": "{base.palette.tint.success}",
              "$type": "color"
            }
          },
          "border": {
            "color": {
              "$value": "{base.palette.tint.success}",
              "$type": "color"
            },
            "radius": {
              "all": {
                "$value": "{base.border.desktop.radius.md}",
                "$type": "dimension"
              }
            },
            "style": {
              "$value": "{base.border.style.solid}",
              "$type": "string"
            },
            "width": {
              "$value": "{base.border.width.xxs}",
              "$type": "dimension"
            }
          },
          "padding": {
            "all": {
              "$value": "24px 24px 16px 24px",
              "$type": "string"
            }
          }
        }
      }
    }
  }
}
