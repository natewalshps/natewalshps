{
  "components": {
    "popover-tooltip": {
      "container": {
        "desktop": {
          "background": {
            "color": {
              "$value": "{base.palette.background.default}",
              "$type": "color"
            }
          },
          "border": {
            "color": {
              "$value": "{base.palette.neutral.80}",
              "$type": "color"
            },
            "radius": {
              "$value": "12px",
              "$type": "dimension"
            },
            "style": {
              "$value": "{base.border.style.solid}",
              "$type": "string"
            },
            "width": {
              "$value": "{base.border.width.xxs}",
              "$type": "dimension"
            }
          },
          "filter": {
            "$value": "drop-shadow(0px 4px 16px rgba(25,25,26,0.16))",
            "$type": "string"
          },
          "padding": {
            "all": {
              "$value": "8px",
              "$type": "dimension"
            }
          }
        }
      }
    }
  }
}
