{
  "components": {
    "tabs": {
      "label": {
        "desktop": {
          "font": {
            "color": {
              "$value": "{base.palette.secondary.linkblue}",
              "$type": "color"
            },
            "line-height": {
              "$value": "{base.typography.desktop.subtitle1-bold.$value.lineHeight}",
              "$type": "dimension"
            },
            "size": {
              "$value": "{base.typography.desktop.subtitle1-bold.$value.fontSize}",
              "$type": "dimension"
            },
            "weight": {
              "$value": "{base.typography.desktop.subtitle1-bold.$value.fontWeight}",
              "$type": "fontWeight"
            }
          },
          "hover": {
            "font": {
              "color": {
                "$value": "{base.palette.secondary.darkblue}",
                "$type": "color"
              }
            }
          },
          "padding": {
            "all": {
              "$value": "0 16px 16px 16px",
              "$type": "string"
            }
          },
          "selected": {
            "font": {
              "color": {
                "$value": "{base.palette.secondary.darkblue}",
                "$type": "color"
              }
            }
          }
        },
        "mobile": {
          "font": {
            "line-height": {
              "$value": "{base.typography.mobile.subtitle1-bold.$value.lineHeight}",
              "$type": "dimension"
            },
            "size": {
              "$value": "{base.typography.mobile.subtitle1-bold.$value.fontSize}",
              "$type": "dimension"
            },
            "weight": {
              "$value": "{base.typography.mobile.subtitle1-bold.$value.fontWeight}",
              "$type": "fontWeight"
            }
          },
          "padding": {
            "all": {
              "$value": "0",
              "$type": "dimension"
            }
          }
        }
      }
    }
  }
}
