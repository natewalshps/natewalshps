{
  "components": {
    "formgroup": {
      "container": {
        "error": {
          "border": {
            "color": {
              "$value": "{base.palette.error.dark}",
              "$type": "color"
            },
            "style": {
              "$value": "{base.border.style.solid}",
              "$type": "string"
            },
            "width": {
              "$value": "{base.border.width.xxs}",
              "$type": "dimension"
            }
          }
        }
      }
    }
  }
}
