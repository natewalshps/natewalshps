{
  "components": {
    "selectable-card": {
      "desktop": {
        "background": {
          "color": {
            "$value": "{base.palette.background.default}",
            "$type": "color"
          }
        },
        "border": {
          "radius": {
            "all": {
              "$value": "12px",
              "$type": "dimension"
            }
          }
        },
        "box-shadow": {
          "$value": "0px 3px 1px -2px rgba(0, 0, 0, 0.2), 0px 2px 2px rgba(0, 0, 0, 0.14), 0px 1px 5px rgba(0, 0, 0, 0.12)",
          "$type": "string"
        },
        "hover": {
          "background": {
            "color": {
              "$value": "{base.palette.neutral.5}",
              "$type": "color"
            }
          }
        },
        "padding": {
          "all": {
            "$value": "24px",
            "$type": "dimension"
          }
        }
      }
    }
  }
}
