{
  "components": {
    "alert": {
      "success": {
        "desktop": {
          "background": {
            "color": {
              "$value": "{base.palette.tint.success}",
              "$type": "color"
            }
          },
          "border": {
            "color": {
              "$value": "{base.palette.success.main}",
              "$type": "color"
            }
          },
          "icon": {
            "color": {
              "$value": "{base.palette.success.main}",
              "$type": "color"
            }
          }
        },
        "title": {
          "desktop": {
            "font": {
              "color": {
                "$value": "{base.palette.success.main}",
                "$type": "color"
              }
            }
          }
        }
      }
    }
  }
}
