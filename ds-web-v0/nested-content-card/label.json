{
  "components": {
    "content-card": {
      "nested": {
        "label": {
          "desktop": {
            "font": {
              "color": {
                "$value": "{base.palette.neutral.70}",
                "$type": "color"
              },
              "line-height": {
                "$value": "{base.typography.desktop.heading4.$value.lineHeight}",
                "$type": "dimension"
              },
              "size": {
                "$value": "{base.typography.desktop.heading4.$value.fontSize}",
                "$type": "dimension"
              },
              "weight": {
                "$value": "{base.typography.desktop.heading4.$value.fontWeight}",
                "$type": "fontWeight"
              }
            },
            "padding": {
              "all": {
                "$value": "0 0 16px 0",
                "$type": "string"
              }
            }
          },
          "mobile": {
            "font": {
              "size": {
                "$value": "{base.typography.mobile.heading4.$value.fontSize}",
                "$type": "dimension"
              }
            }
          }
        },
        "mobile": {
          "font": {
            "line-height": {
              "$value": "{base.typography.mobile.heading4.$value.lineHeight}",
              "$type": "dimension"
            },
            "weight": {
              "$value": "{base.typography.mobile.heading4.$value.fontWeight}",
              "$type": "fontWeight"
            }
          }
        }
      }
    }
  }
}
